# Скопируйте в .env и заполните. .env НЕ коммитится.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Пароль администратора бота (вход: /start → ввести пароль)
ADMIN_PASSWORD=
# Длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ВНИМАНИЕ: при смене все выданные пароли педагогов перестанут работать.
APP_SECRET=
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10
GENERATED_PASSWORD_LENGTH=10

# --- БД (по умолчанию SQLite в data/socrat.db) ---
# DATABASE_URL=sqlite+aiosqlite:///./data/socrat.db
# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/socrat

# --- LLM: любой OpenAI-совместимый API ---
# OpenRouter:
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
# Альтернатива: LLM_MODEL=google/gemma-3-27b-it (обновите тарифы ниже)
# Локальная модель на сервере заказчика (Ollama):
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=gemma3:27b
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=12000
LLM_TIMEOUT_S=180
# auto | json_schema | json_object | prompt  (auto: пробует json_schema, откатывается на prompt)
LLM_JSON_MODE=prompt
LLM_MAX_REPAIRS=2
# Цена для учёта расходов (USD за 1M токенов): DeepSeek V4.1 Flash на OpenRouter, 24.09.2026
# Проверьте актуальный тариф и провайдера перед запуском.
LLM_PRICE_IN_PER_1M=0.13
LLM_PRICE_OUT_PER_1M=0.52

# --- Эмбеддинги (OpenAI-совместимый /embeddings). Пусто → поиск только BM25 ---
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# --- Нормативная база ---
# KNOWLEDGE_DIR=./data/knowledge

# --- Ограничения работы ---
WORK_MINUTES_MIN=15
WORK_MINUTES_MAX=20
MAX_TASKS=8
MAX_CONCURRENT_GENERATIONS=3

# true — бот работает на фейках (без LLM и без базы), для разработки UI
USE_FAKES=false
LOG_LEVEL=INFO
